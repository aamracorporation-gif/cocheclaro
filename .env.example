# ─────────────────────────────────────────────────────────────
# CocheClaro — variables de entorno
# Copia este archivo a `.env.local` y ajusta los valores.
# El proyecto ARRANCA sin configurar nada de esto: por defecto
# usa el proveedor de datos local (data/*.ts). Supabase es opcional.
# ─────────────────────────────────────────────────────────────

# URL canónica pública del sitio (sin barra final). Se usa en
# metadatos, canonical, sitemap y JSON-LD.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Nombre visible del sitio (marca provisional).
NEXT_PUBLIC_SITE_NAME=CocheClaro

# ── Publicidad ───────────────────────────────────────────────
# Los slots de AdSense están DESACTIVADOS por defecto. Actívalos
# solo tras integrar una CMP certificada (ver §14 del Plan Maestro).
NEXT_PUBLIC_ADS_ENABLED=false
NEXT_PUBLIC_ADSENSE_CLIENT=

# ── Proveedor de datos ───────────────────────────────────────
# "local"  -> lee de data/*.ts (por defecto, sin dependencias)
# "supabase" -> lee de Supabase/PostgreSQL (requiere migraciones + seed)
DATA_PROVIDER=local

# Solo si DATA_PROVIDER=supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Analítica ────────────────────────────────────────────────
# La capa de tracking no está acoplada a ningún proveedor.
# Deja vacío para registrar los eventos solo en consola (modo dev).
NEXT_PUBLIC_ANALYTICS_ENDPOINT=
