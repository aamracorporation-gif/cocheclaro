# ─────────────────────────────────────────────────────────────
# CocheClaro — variables de entorno
# Copia este archivo a `.env.local` y ajusta los valores.
# El proyecto ARRANCA sin configurar nada de esto: por defecto
# usa el proveedor de datos local (data/*.ts). Supabase es opcional.
# ─────────────────────────────────────────────────────────────

# URL canónica pública del sitio (sin barra final). Se usa en
# metadatos, canonical, sitemap y JSON-LD.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Nombre visible del sitio (marca provisional).
NEXT_PUBLIC_SITE_NAME=CocheClaro

# ── Publicidad ───────────────────────────────────────────────
# Los slots de AdSense están DESACTIVADOS por defecto. Actívalos
# solo tras integrar una CMP certificada (ver §14 del Plan Maestro).
NEXT_PUBLIC_ADS_ENABLED=false
NEXT_PUBLIC_ADSENSE_CLIENT=

# ── Proveedor de datos ───────────────────────────────────────
# "local"  -> lee de data/*.ts (por defecto, sin dependencias)
# "supabase" -> lee de Supabase/PostgreSQL (requiere migraciones + seed)
DATA_PROVIDER=local

# Solo si DATA_PROVIDER=supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secreta: bypassa RLS. Solo la usan las Server Actions de /admin. NUNCA la
# expongas al navegador ni la prefijes con NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Acceso a /admin ──────────────────────────────────────────
# El panel editorial está protegido por contraseña (middleware.ts). Sin estas
# dos variables, /admin no es accesible (fallará el login, no queda abierto).
# Genera ADMIN_SESSION_SECRET con: openssl rand -base64 32
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# ── Campañas / llamadas a revisión (NHTSA, EE. UU.) ──────────
# La ficha de generación muestra una sección con las llamadas a revisión
# oficiales de la NHTSA de Estados Unidos (API pública, sin clave). Son datos
# del mercado estadounidense, etiquetados como tal. Ponlo a "false" si los
# builds se vuelven lentos o quieres desactivar la sección.
RECALLS_ENABLED=true

# ── Analítica ────────────────────────────────────────────────
# La capa de tracking no está acoplada a ningún proveedor.
# Deja vacío para registrar los eventos solo en consola (modo dev).
NEXT_PUBLIC_ANALYTICS_ENDPOINT=
